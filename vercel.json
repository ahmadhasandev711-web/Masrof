{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "regions": ["fra1"],
  "functions": {
    "src/app/api/receipts/scan/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "src/app/api/uploads/receipt/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/admin/upload/route.ts": {
      "maxDuration": 30
    }
  }
}
