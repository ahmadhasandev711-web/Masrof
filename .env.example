# --- Database ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
# Optional on Windows if SRV DNS fails — paste the full standard connection string from Atlas:
# Database → Connect → Drivers → "Connection string only" (mongodb://... NOT mongodb+srv)
MONGODB_URI_DIRECT=
# Set to 1 only if mongodb+srv fails on Windows and you need manual SRV resolution
MONGODB_RESOLVE_SRV=
MONGODB_DB_NAME=sanadat

# --- Auth (better-auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Same URL, exposed to the browser (must start with NEXT_PUBLIC_)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Extra allowed origins for better-auth (comma-separated), e.g. preview + custom domain:
# Production (Vercel): https://masrof-five.vercel.app
# The Expo app scheme sanadat:// is already trusted in code.
# TRUSTED_ORIGINS=https://masrof-five.vercel.app,https://*.vercel.app
TRUSTED_ORIGINS=

# --- Email (Resend) — مطلوب لإرسال البريد فعلياً ---
# بدونها: التأكيد معطّل + الإشعارات تتطبع في التيرمنال فقط
RESEND_API_KEY=
AUTH_EMAIL_FROM=مصروفاتي <noreply@yourdomain.com>

# --- PWA Push notifications (optional) ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@sanadat.site

# --- Platform admin ---
# Comma-separated emails allowed to access /admin
ADMIN_EMAILS=you@example.com
# One-time setup for npm run seed:admin (remove password after running)
SEED_ADMIN_NAME=مدير مصروفاتي
SEED_ADMIN_PASSWORD=

# --- Support & social (optional) ---
SUPPORT_EMAIL=support@sanadat.site
SUPPORT_WHATSAPP=201000000000
SUPPORT_WHATSAPP_DISPLAY=+20 100 000 0000
SOCIAL_FACEBOOK_URL=
SOCIAL_LINKEDIN_URL=

# 1. Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# 2. Authorized JavaScript origins: http://localhost:3000
# 3. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# 4. Paste Client ID + Secret below — زر Google يظهر تلقائياً في /login و /register
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Object storage (optional — Cloudflare R2 / S3-compatible) ---
# Without these, uploads go to public/uploads (lost on Hostinger/Vercel redeploy).
# For R2: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev  (or custom CDN domain)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# --- Paymob (optional — online upgrades; manual admin until activated) ---
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_HMAC_SECRET=
# PAYMOB_IFRAME_ID=

# --- Google AdSense (optional — public blog/marketing pages only) ---
# Get from AdSense → Account → Account information (ca-pub-XXXXXXXX)
# Create ad units in AdSense → Ads → By ad unit, then paste slot IDs below.
# Without these, AdSlot shows a placeholder (safe for local dev).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Fallback slot used when a placement-specific slot is empty
NEXT_PUBLIC_ADSENSE_SLOT_DEFAULT=
# Optional per-placement slots (blog article top, article end, blog sidebar)
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_END=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
